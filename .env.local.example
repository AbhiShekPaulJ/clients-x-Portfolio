# Copy this file to .env.local and fill in your real Razorpay keys.
# Get these from the Razorpay Dashboard -> Settings -> API Keys.
# Use the "Test Mode" keys while developing, and switch to "Live Mode" keys
# only once the account is fully activated for real payments.

RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
